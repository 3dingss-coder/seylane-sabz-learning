ALLOWED_ORIGINS=
API_PROXY_TARGET=
APP_ENV=
BACKUP_BUCKET=
DATA_BACKEND=
FIREBASE_WEB_API_KEY=
MAIL_FROM=
PORT=
SMTP_URL=
TRUST_PROXY_HOPS=
VITE_API_BASE=
VITE_APP_ENV=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
