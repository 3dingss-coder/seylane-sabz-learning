# Copy to .env.local for local runs. In CI the deploy workflow writes functions/.env from secrets.
# NEVER commit real values.
# Comma-separated CORS allowlist. Add https://localhost for the Android (Capacitor) app.
ALLOWED_ORIGINS=http://localhost:5173
# dev | prod
APP_ENV=dev
# memory (local, no Firebase) | firestore (emulator / real project)
DATA_BACKEND=memory
# Firebase web API key — used server-side for password sign-in via Identity Toolkit (D35)
FIREBASE_WEB_API_KEY=
# Optional: Gemini key for the AI mentor chat (without it the mentor answers from the rules only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: gs:// bucket for the daily Firestore export (needs Datastore Import Export Admin role)
BACKUP_BUCKET=
