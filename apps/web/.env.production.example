# Copy to .env.production.local — values here are PUBLIC build-time config (not secrets).
VITE_APP_ENV=prod
# API origin (Cloud Function). Required for the Android app; the PWA may also use it directly.
VITE_API_BASE=https://europe-west1-YOUR_PROJECT.cloudfunctions.net/api
# Optional error monitoring (Sentry free tier). Leave empty to disable.
VITE_SENTRY_DSN=
# Android only: set to true when android/app/google-services.json exists (else FCM init crashes).
VITE_PUSH_ENABLED=false
