# Copy to .env.development.local — values here are PUBLIC web config (not secrets).
VITE_APP_ENV=dev
# Firebase web config for the *dev* project (filled once the project exists)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Where the Vite dev server proxies /v1 (local API or functions emulator)
API_PROXY_TARGET=http://127.0.0.1:5001
