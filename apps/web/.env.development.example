# Copy to .env.development.local — values here are PUBLIC build-time config (not secrets).
VITE_APP_ENV=dev
# Empty = same origin (the Vite dev server proxies /v1). Set to the API origin for Android dev builds.
VITE_API_BASE=
VITE_SENTRY_DSN=
VITE_PUSH_ENABLED=false
# Where the Vite dev server proxies /v1 (local API or functions emulator)
API_PROXY_TARGET=http://127.0.0.1:5001
