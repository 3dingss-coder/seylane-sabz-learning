# Netlify / Cloudflare Pages routing rules.
# Public catalog & branding images resolve directly from the static CDN bundle;
# /v1/* API requests route to the bundled Netlify Function (or external Cloud Function if overridden in CI);
# all other routes fall back to the SPA entry point.
/v1/files/public/branding/holding-logo.png  /icons/logo-full.png       200
/v1/files/public/*                          /catalog/:splat            200
/v1/*                                       /.netlify/functions/api    200
/*                                          /index.html                200
