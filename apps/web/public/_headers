# Cloudflare Pages security headers (spec §24).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.youtube.com https://www.youtube-nocookie.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.pages.dev https://*.workers.dev https://firebasestorage.googleapis.com https://storage.googleapis.com https://i.ytimg.com https://*.ytimg.com; media-src 'self' blob: data: https://*.pages.dev https://*.workers.dev https://firebasestorage.googleapis.com https://storage.googleapis.com; font-src 'self' data:; connect-src 'self' blob: https://*.pages.dev https://*.workers.dev https://*.netlify.app https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://*.firebaseio.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# Long-lived caching: Vite hashes everything under /assets/, so it can be cached "forever".
# Without this, every visit re-validates each file against the server — slow on weak networks.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800
# Catalog file names are stable (not hashed): cache a day, serve stale while refreshing.
/catalog/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The app shell and service-worker files must always be revalidated, otherwise a browser or CDN keeps
# serving an old copy and users never see a new version. (Hashed files under /assets/ stay immutable.)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/push-sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
